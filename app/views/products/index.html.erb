<style>
.main {
    .product {
        border: 1px solid #ccc;
        padding: 16px;
        margin-bottom: 10px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .actions {
        display: flex;
        gap: 8px;
    }

    .spacer {
        flex-grow: 1;
    }
}
</style>

<% if flash[:message] %>
    <p><%= flash[:message] %></p>
<% end %>

<div class="main">
    <div class="actions">
        <%= link_to 'カートを見る', carts_show_path %>
        <div class="spacer"></div>
        <%= link_to '商品登録', products_new_path %>
    </div>

    <% @products.each do |product| %>
        <div class="product">
            <div>商品名: <%= product.name %></div>
            <div>価格: <%= product.price %></div>
            <div class="actions">
                <%= link_to 'カートに追加', cart_items_new_path(product.id) %>
                <div class="spacer"></div>
                <%= link_to '削除', products_destroy_path(product.id), data: { turbo_method: :delete }  %>
            </div>
        </div>
    <% end %>
</div>